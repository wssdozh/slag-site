---
import Base from '../layouts/Base.astro';
import latest from '../data/latest.json';
import plansData from '../data/plans.json';
import releasesData from '../data/releases.json';

const version = latest?.version ?? '';
const downloads: Record<string, string> = latest?.downloads ?? {};
// Sizes come from the GitHub release and are allowed to be missing; nothing is shown rather than
// a guessed number.
const sizes: { windows?: number | null; android?: number | null } =
  (latest as { sizes?: { windows?: number | null; android?: number | null } })?.sizes ?? {};
const megabytes = (bytes?: number | null) =>
  typeof bytes === 'number' && bytes > 0 ? `${(bytes / 1048576).toFixed(1).replace('.', ',')} МБ` : '';
const plans: Array<{
  id: string;
  label: string;
  priceRub: number;
  devices: number;
  cacheMb: number;
  summary: string;
  features: string[];
}> = plansData?.plans ?? [];
const money = (rub: number) => (rub > 0 ? `${rub} ₽ / мес` : '0 ₽ навсегда');
const gb = (mb: number) => (mb >= 1024 ? `${Math.round(mb / 1024)} ГБ` : `${mb} МБ`);
// "2 устройств" is what a template without plural forms writes; the plan limits are the one
// place on the page where a number meets a noun in the accusative.
const devices = (count: number) => {
  const tail = count % 100;
  const last = count % 10;
  if (tail >= 11 && tail <= 14) return `${count} устройств`;
  if (last === 1) return `${count} устройство`;
  if (last >= 2 && last <= 4) return `${count} устройства`;
  return `${count} устройств`;
};

const features = [
  {
    title: 'Markdown на диске',
    body: 'Каждая запись — .md с YAML frontmatter. Папка, корзина и вложения — файлы, которые видно в проводнике.',
    shot: '/shots/folder.png',
    zoom: '1.9',
    x: '18%',
    y: '42%',
  },
  {
    title: 'Поток как в мессенджере',
    body: 'Одно поле ввода, Enter отправляет. Тип записи выбирается в нём же: заметка, задача или статья.',
    shot: '/shots/editor.png',
    zoom: '1.7',
    x: '50%',
    y: '12%',
  },
  {
    title: 'Поиск по всему хранилищу',
    body: 'Orama BM25 с опечатками ищет по заголовкам, тексту, тегам и папкам. Вызов — Ctrl+K.',
    shot: '/shots/search.png',
    zoom: '2',
    x: '48%',
    y: '40%',
  },
  {
    title: 'Аудио и вложения рядом',
    body: 'Войсы, картинки и файлы лежат в .attachments/ и открываются из карточки — без облака посередине.',
  },
  {
    title: 'ИИ-разбор входящих',
    body: 'Входящие разбираются по папкам с их описаниями. Своим ключом Gemini или через подписку — на выбор.',
    shot: '/shots/triage.png',
    zoom: '2.2',
    x: '50%',
    y: '46%',
  },
  {
    title: 'MCP для своих агентов',
    body: 'Встроенный MCP-сервер отдаёт заметки, задачи и папки Claude Desktop, Cursor и другим клиентам по stdio.',
  },
];

const facts = [
  {
    label: 'формат',
    text: 'markdown, его читает Obsidian',
    href: '/docs/vault',
  },
  {
    label: 'аккаунт',
    text: 'не нужен: пара по коду',
    href: '/docs/install',
  },
  {
    label: 'релей',
    text: 'свой сервер вместо подписки',
    href: '/docs/sync',
  },
];

const shots = [
  { src: '/shots/search.png', caption: 'поиск по хранилищу', width: 1280, height: 800, phone: false },
  { src: '/shots/triage.png', caption: 'разбор входящих', width: 1280, height: 800, phone: false },
  { src: '/shots/mobile.png', caption: 'телефон: задачи', width: 390, height: 844, phone: true },
  { src: '/shots/folder.png', caption: 'папка: описание для ИИ и медиа', width: 1280, height: 800, phone: false },
];

// The changelog is the release notes the app itself shows, shortened to their first line:
// a landing that never changes looks abandoned next to these.
const updates = (Array.isArray(releasesData) ? releasesData : [])
  .slice(0, 3)
  .map((release: { version: string; date: string; url: string; notes?: string }) => ({
    version: release.version,
    date: release.date,
    url: release.url,
    note: (release.notes ?? '').split('\n')[0],
  }))
  .filter((release) => release.note);

const day = (iso: string) => {
  if (!iso) return '';
  const [year, month, date] = iso.split('-');
  return date ? `${date}.${month}.${year}` : iso;
};

const faq = [
  {
    q: 'Куда уходят мои заметки?',
    a: 'На диск. Если включить синхронизацию, между устройствами ходят только зашифрованные пакеты изменений: сервер не хранит историю и удаляет пакет сразу после доставки.',
  },
  {
    q: 'Что будет, если сервер выключится?',
    a: 'Приложение продолжит работать: заметки читаются и пишутся локально. Пропадёт только синхронизация между устройствами, и то до момента, пока сервер не вернётся.',
  },
  {
    q: 'Нужен ли аккаунт с почтой и паролем?',
    a: 'Нет. Устройства сопрягаются парой по короткому коду, аккаунт восстанавливается сид-фразой. Почта нужна только для связи с поддержкой, если сам её укажешь.',
  },
  {
    q: 'Откроется ли это в Obsidian?',
    a: 'Да, это и есть цель формата: .md с frontmatter, вложения в .attachments/, удалённое в .trash/. Экспорт в markdown есть в настройках.',
  },
];
---

<Base
  title={`SLAG ${version} — локальные заметки в markdown`}
  description="SLAG — заметки и задачи в открытом markdown на вашем диске. Поток как в мессенджере, поиск по всему хранилищу, шифрованная синхронизация без аккаунта."
>
  <section class="wrap hero">
    <span class="hero__badge">
      <span class="dot"></span>
      <span>релиз {version} · Windows 10/11, Android, Linux</span>
    </span>

    <h1>
      Заметки со скоростью чата.<br />
      <span>Файлы остаются твоими.</span>
    </h1>

    <p class="hero__lead">
      Одно поле, Enter — мысль записана. Задача, статья или войс лежат рядом, а на диске это
      обычные markdown-файлы, которые открывает Obsidian.
    </p>

    <div class="hero__actions">
      <a class="btn btn--primary" href={downloads.windows ?? '/releases'} data-download="windows">
        Скачать для Windows
      </a>
      <a class="btn btn--ghost" href="/releases">Все платформы и версии</a>
    </div>

    <p class="hero__note">портативная сборка · работает офлайн</p>

    <div class="hero__shot">
      <img src="/shots/editor.png" alt="Экран SLAG: редактор, теги, панель папки" width="1280" height="720" />
    </div>
  </section>

  <section class="wrap proof" aria-label="Коротко о продукте">
    {facts.map((fact) => (
      <a class="proof__item" href={fact.href}>
        <span class="proof__label">{fact.label}</span>
        <span class="proof__text">{fact.text}</span>
      </a>
    ))}
  </section>

  <section class="wrap section" id="features">
    <span class="section__label">что внутри</span>
    <h2>Один экран, одна запись</h2>
    <p class="section__lead">
      Воркспейсов, шаблонов и онбординга на десять шагов тут нет.
    </p>

    <div class="grid grid--3 grid--features">
      {features.map((feature) => (
        <article class="card">
          {feature.shot && (
            <span class="card__visual" aria-hidden="true">
              <img
                class="card__shot"
                src={feature.shot}
                alt=""
                loading="lazy"
                decoding="async"
                style={`--zoom:${feature.zoom};--x:${feature.x};--y:${feature.y}`}
              />
            </span>
          )}
          <h3><span class="card__icon">—</span>{feature.title}</h3>
          <p>{feature.body}</p>
        </article>
      ))}
    </div>

    <p class="docs-links">
      подробнее:
      <a href="/docs/install">установка</a>
      <a href="/docs/vault">хранилище</a>
      <a href="/docs/sync">синхронизация</a>
      <a href="/docs/mcp">MCP</a>
    </p>
  </section>

  <section class="wrap section" id="screens">
    <span class="section__label">как выглядит</span>
    <h2>Поиск, папка, разбор, телефон</h2>

    <div class="carousel" data-carousel>
      <div class="carousel__head">
        <span class="carousel__count">
          <span data-carousel-count>01</span> / {String(shots.length).padStart(2, '0')}
        </span>
      </div>

      <div
        class="carousel__track"
        data-carousel-track
        tabindex="0"
        role="group"
        aria-roledescription="карусель"
        aria-label="Скриншоты приложения"
      >
        {shots.map((shot, index) => (
          <figure
            class={`shot${shot.phone ? ' shot--phone' : ''}`}
            role="group"
            aria-roledescription="слайд"
            aria-label={`${index + 1} из ${shots.length}: ${shot.caption}`}
          >
            <button
              class="shot__open"
              type="button"
              data-shot
              data-index={index}
              data-src={shot.src}
              data-caption={shot.caption}
              data-width={shot.width}
              data-height={shot.height}
              aria-label={`Открыть скриншот: ${shot.caption}`}
            >
              <img
                src={shot.src}
                alt={shot.caption}
                width={shot.width}
                height={shot.height}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                draggable="false"
              />
              <span class="shot__zoom" aria-hidden="true">открыть</span>
            </button>
            <figcaption>
              <span class="shot__index">{String(index + 1).padStart(2, '0')}</span>
              {shot.caption}
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="carousel__progress" aria-hidden="true">
        <span data-carousel-progress></span>
      </div>
    </div>
  </section>

  <section class="wrap section" id="data">
    <span class="section__label">где мои данные</span>
    <h2>Хранилище — папка на диске</h2>

    <div class="grid grid--3">
      <article class="card">
        <h3><span class="card__icon">1</span> Папку выбираешь сам</h3>
        <p>
          Приложение не прячет заметки в свою базу. Сломался компьютер — открыл ту же папку на
          другом, всё на месте.
        </p>
      </article>
      <article class="card">
        <h3><span class="card__icon">2</span> Релей не читает</h3>
        <p>
          Пакеты изменений шифруются на устройстве. Сервер видит размер и адресата, а содержимое
          удаляет сразу после подтверждения доставки.
        </p>
      </article>
      <article class="card">
        <h3><span class="card__icon">3</span> Свой релей</h3>
        <p>
          Синхронизация не обязана быть нашей: релей открыт, ставится на домашний сервер и работает
          с тем же приложением.
        </p>
      </article>
    </div>
  </section>

  <section class="wrap section" id="download">
    <span class="section__label">скачать</span>
    <h2>Сборка {version}</h2>
    <p class="section__lead">
      Windows и Android обновляются изнутри приложения. Linux — пакетным менеджером.
    </p>

    <div class="grid grid--3">
      <article class="card">
        <h3><span class="card__icon">win</span> Windows 10/11</h3>
        <p>.exe, x64. Портативная сборка и установщик в одном релизе.</p>
        {sizes.windows && <p class="lead-mono" style="margin-top:8px">{megabytes(sizes.windows)}</p>}
        <p style="margin-top:14px">
          <a class="btn btn--primary btn--small" href={downloads.windows ?? '/releases'} data-download="windows">
            Скачать .exe
          </a>
        </p>
      </article>
      <article class="card">
        <h3><span class="card__icon">apk</span> Android</h3>
        <p>Установка из apk, обновления — тоже apk, поверх старой версии.</p>
        {sizes.android && <p class="lead-mono" style="margin-top:8px">{megabytes(sizes.android)}</p>}
        <p style="margin-top:14px">
          <a class="btn btn--ghost btn--small" href={downloads.android ?? '/releases'} data-download="android">
            Скачать apk
          </a>
        </p>
      </article>
      <article class="card">
        <h3><span class="card__icon">nix</span> Linux</h3>
        <p>Бинарник принадлежит пакетному менеджеру, приложение его не подменяет.</p>
        <p style="margin-top:14px">
          <a class="btn btn--ghost btn--small" href="/releases">Страница релиза</a>
        </p>
      </article>
    </div>
  </section>

  <section class="wrap section" id="changelog">
    <span class="section__label">что нового</span>
    <h2>Что менялось в сборках</h2>

    <div class="changelog">
      {updates.map((update) => (
        <a class="changelog__row" href={update.url} rel="noreferrer">
          <span class="changelog__version">{update.version}</span>
          <span class="changelog__date">{day(update.date)}</span>
          <span class="changelog__note">{update.note}</span>
        </a>
      ))}
    </div>

    <p class="docs-links">
      <a href="/releases">все релизы и заметки</a>
    </p>
  </section>

  <section class="wrap section" id="pricing">
    <span class="section__label">тарифы</span>
    <h2>Сколько стоит синхронизация</h2>
    <p class="section__lead">
      Само приложение бесплатное и работает без сети. Подписка оплачивает синхронизацию: устройства,
      место под недоставленные вложения и ИИ-разбор.
    </p>

    <div class="plans">
      {plans.map((plan) => (
        <article class={`plan${plan.id === 'smile' ? ' plan--featured' : ''}`}>
          <div class="plan__head">
            <span class="plan__name">{plan.label}</span>
            <span class="plan__price">{money(plan.priceRub)}</span>
          </div>
          <p class="plan__desc">{plan.summary}</p>
          <p class="plan__limits">{devices(plan.devices)} · кеш {gb(plan.cacheMb)}</p>
          <ul>
            {plan.features.map((feature: string) => <li>{feature}</li>)}
          </ul>
          {plan.priceRub > 0 ? (
            <button
              class="btn btn--ghost btn--small"
              type="button"
              data-pay={plan.label}
              aria-expanded="false"
            >
              Оплатить
            </button>
          ) : (
            <a class="btn btn--primary btn--small" href={downloads.windows ?? '/releases'} data-download="windows">
              Скачать бесплатно
            </a>
          )}
          {plan.priceRub > 0 && (
            <div class="pay-note" data-pay-note>
              <div class="pay-note__inner">
                <p class="notice">
                  Оплата ещё не подключена: эквайринг на согласовании. Напиши на{' '}
                  <a href="mailto:support@slag.app">support@slag.app</a> — включим тариф вручную и
                  зачтём оплату, когда он заработает.
                </p>
              </div>
            </div>
          )}
        </article>
      ))}
    </div>

    <div class="notice">
      Свой релей — бесплатно и без лимитов: синхронизация открыта, ставится на домашний сервер или
      VPS. Платные тарифы нужны тем, кому не хочется администрировать.
    </div>
  </section>

  <section class="wrap section" id="faq">
    <span class="section__label">вопросы</span>
    <h2>Про диск, сервер и аккаунт</h2>

    <div class="faq">
      {faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="wrap cta" id="start">
    <h2>Поставь и запиши первую мысль</h2>
    <p class="cta__note">0 ₽ · без аккаунта · работает офлайн</p>
    <div class="cta__actions">
      <a class="btn btn--primary" href={downloads.windows ?? '/releases'} data-download="windows">
        Скачать для Windows
      </a>
      <a class="btn btn--ghost" href="/releases">Все платформы и версии</a>
    </div>
  </section>

  <section class="wrap section" id="community">
    <span class="section__label">куда писать</span>
    <h2>Документация, Telegram, GitHub</h2>

    <div class="grid grid--3">
      <article class="card">
        <h3><span class="card__icon">doc</span> Документация</h3>
        <p>Установка, формат хранилища, синхронизация и MCP-сервер — без видео на двадцать минут.</p>
        <a class="card__link" href="/docs">Открыть документацию →</a>
      </article>
      <article class="card">
        <h3><span class="card__icon">tg</span> Telegram</h3>
        <p>Анонсы сборок и заметки о разработке. Без рассылок и «полезных подборок».</p>
        <a class="card__link" href="https://t.me/slag_notes" rel="noreferrer">t.me/slag_notes →</a>
      </article>
      <article class="card">
        <h3><span class="card__icon">git</span> GitHub</h3>
        <p>Исходники, баги и предложения. Приложение и релей открыты целиком.</p>
        <a class="card__link" href="https://github.com/wssdozh/slag-v2/issues" rel="noreferrer">Завести issue →</a>
      </article>
    </div>
  </section>

  <dialog class="lightbox" data-lightbox aria-label="Скриншоты SLAG">
    <div class="lightbox__bar">
      <span class="lightbox__counter" data-counter aria-live="polite">01 / 04</span>
      <button class="iconbtn" type="button" data-close aria-label="Закрыть">
        <span aria-hidden="true">✕</span>
      </button>
    </div>
    <img class="lightbox__stage" data-stage src="/shots/search.png" alt="" width="1280" height="800" />
    <div class="lightbox__foot">
      <button class="iconbtn" type="button" data-prev aria-label="Предыдущий скриншот">
        <span aria-hidden="true">←</span>
      </button>
      <p class="lightbox__caption" data-caption></p>
      <button class="iconbtn" type="button" data-next aria-label="Следующий скриншот">
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </dialog>

  <script>
    import '../scripts/landing';
  </script>
</Base>
