---
// Decorative: the same note on a phone and on a laptop, with the tick landing on both.
---
<div class="ill ill--sync" aria-hidden="true">
  <div class="ill__panel ill__phone">
    <span class="ill__mono" style="padding:0 4px 2px">задачи</span>
    <div class="ill__row">
      <span class="ill__tick"></span>
      <span>позвонить в сервис</span>
    </div>
    <div class="ill__row">
      <span class="ill__dot"></span>
      <span>купить чай</span>
    </div>
    <div class="ill__row">
      <span class="ill__dot"></span>
      <span>чекап</span>
    </div>
  </div>

  <i class="ill__wire"></i>

  <div class="ill__panel ill__desk">
    <div class="ill__row">
      <span>позвонить в сервис</span>
      <span class="ill__tick"></span>
    </div>
    <div class="ill__row">
      <span>купить чай</span>
    </div>
    <div class="ill__row ill__mono">входящие · 2</div>
  </div>
</div>
