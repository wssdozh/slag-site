---
// Decorative: a note is typed, Enter turns it into a card, and a tag follows. No pictures — every
// layer is a div, so the illustration stays sharp and weighs nothing.
---
<div class="ill ill--composer" aria-hidden="true">
  <div class="ill__panel ill__card">
    <div class="ill__card-head">
      <span class="ill__dot"></span>
      <span class="ill__title">Сервис</span>
      <span class="ill__mono">15:00</span>
      <span class="ill__tick"></span>
    </div>
    <span class="ill__mono">завтра · задача · карьера</span>
  </div>

  <div class="ill__panel ill__ghost">
    <span class="ill__title">Купить чай</span>
    <span class="ill__mono">сегодня · личное</span>
  </div>

  <div class="ill__panel ill__input">
    <span class="ill__query">
      <span>позвонить в сервис завтра в 15:00</span>
      <i class="ill__caret"></i>
    </span>
  </div>

  <span class="ill__panel ill__tag ill__chip">#звонки</span>
</div>
