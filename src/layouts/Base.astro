---
import '../styles/site.css';
import '../styles/motion.css';
import latest from '../data/latest.json';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
// Only real pages get marked: nav entries pointing into the landing (`/#features`) are anchors.
const here = (target: string): 'page' | undefined =>
  path === target || path.startsWith(`${target}/`) ? 'page' : undefined;

const nav = [
  { href: '/#features', label: 'Возможности' },
  { href: '/#pricing', label: 'Тарифы' },
  { href: '/docs', label: 'Документация' },
  { href: '/releases', label: 'Релизы' },
  { href: '/support', label: 'Поддержка' },
];

const footerNav = [
  {
    title: 'продукт',
    links: [
      { href: '/#features', label: 'Возможности' },
      { href: '/#pricing', label: 'Тарифы' },
      { href: '/#download', label: 'Скачать' },
      { href: '/releases', label: 'Релизы' },
    ],
  },
  {
    title: 'документация',
    links: [
      { href: '/docs', label: 'Обзор' },
      { href: '/docs/install', label: 'Установка' },
      { href: '/docs/vault', label: 'Хранилище' },
      { href: '/docs/sync', label: 'Синхронизация' },
      { href: '/docs/mcp', label: 'MCP-сервер' },
    ],
  },
  {
    title: 'сообщество',
    links: [
      { href: 'https://github.com/wssdozh/slag-v2', label: 'GitHub' },
      { href: 'https://github.com/wssdozh/slag-v2/issues', label: 'Issues' },
      { href: 'https://t.me/slag_notes', label: 'Telegram' },
      { href: '/support', label: 'Поддержка' },
    ],
  },
];

const legalLinks = [
  { href: '/privacy', label: 'Политика конфиденциальности' },
  { href: '/terms', label: 'Соглашение' },
  { href: '/consent', label: 'Согласие на обработку данных' },
];

const version = latest?.version ?? null;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f0f0f" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/icon.png" type="image/png" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SLAG" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // `.js` gates every hidden-by-default state in motion.css, so it is set only when scripting
      // actually runs. The watchdog covers the case where the bundle never arrives: content must
      // never stay invisible because one file 404'd.
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (document.documentElement.dataset.reveal !== 'ready') {
          document.documentElement.classList.remove('js');
        }
      }, 2500);
    </script>
  </head>
  <body>
    <header class="site-header" data-header>
      <div class="wrap site-header__row">
        <a class="brand" href="/">
          <img src="/icon.png" alt="" width="24" height="24" />
          <span>SLAG</span>
        </a>

        <nav class="site-nav">
          {nav.map((item) => (
            <a href={item.href} aria-current={here(item.href)}>{item.label}</a>
          ))}
          <a href="https://github.com/wssdozh/slag-v2" rel="noreferrer">GitHub</a>
        </nav>

        <a class="btn btn--primary btn--small" href="/#download">Скачать</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="site-footer__grid">
          <div class="site-footer__mark">
            <a class="brand" href="/">
              <img src="/icon.png" alt="" width="24" height="24" />
              <span>SLAG</span>
            </a>
            <span>Заметки и задачи в markdown на своём диске.</span>
            {version && <span class="mono">версия {version}</span>}
          </div>

          {footerNav.map((column) => (
            <nav class="site-footer__col" aria-label={column.title}>
              <span class="site-footer__title">{column.title}</span>
              {column.links.map((link) => (
                <a href={link.href} rel={link.href.startsWith('http') ? 'noreferrer' : undefined}>
                  {link.label}
                </a>
              ))}
            </nav>
          ))}
        </div>

        <div class="site-footer__bottom">
          <span>© {year} SLAG</span>
          <nav class="site-footer__legal">
            {legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          </nav>
          <a href="/status">статус сервера</a>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/reveal';

      // The fade under the header belongs to the state "content is under the bar", not to the
      // header itself: without a scroll listener it would be a permanent hairline again.
      const header = document.querySelector<HTMLElement>('[data-header]');      if (header) {
        const sync = () => {
          header.dataset.scrolled = window.scrollY > 8 ? 'true' : 'false';
        };
        sync();
        window.addEventListener('scroll', sync, { passive: true });
      }

      // Scrollspy: on the landing the two in-page nav entries say which section you are in.
      // The band in the middle of the viewport decides, so neither entry lights up while the
      // previous section is still half on screen.
      const spyLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.site-nav a[href^="/#"]'));
      if (spyLinks.length > 0 && window.location.pathname === '/') {
        const targets = new Map<string, HTMLAnchorElement>();
        for (const link of spyLinks) {
          const id = (link.getAttribute('href') ?? '').slice(2);
          if (id) targets.set(id, link);
        }
        const spy = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const link = targets.get(entry.target.id);
              if (link) link.toggleAttribute('data-active', entry.isIntersecting);
            }
          },
          { rootMargin: '-45% 0px -45% 0px' },
        );
        for (const id of targets.keys()) {
          const section = document.getElementById(id);
          if (section) spy.observe(section);
        }
      }
    </script>
  </body>
</html>
