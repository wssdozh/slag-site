---
// Decorative: the vault is a folder of .md files, and the metadata panel is a window into one.
---
<div class="ill ill--files" aria-hidden="true">
  <span class="ill__chip ill__badge">markdown</span>
  <span class="ill__mono ill__path">~/vault</span>

  <div class="ill__panel ill__tree">
    <i class="ill__cursor"></i>
    <div class="ill__row"><span>карьера.md</span></div>
    <div class="ill__row"><span>проекты.md</span></div>
    <div class="ill__row"><span>личное.md</span></div>
  </div>

  <div class="ill__panel ill__meta">
    <div class="ill__meta-row"><span>размер</span><span class="ill__mono">1,4 КБ</span></div>
    <div class="ill__meta-row"><span>изменён</span><span class="ill__mono">09:12</span></div>
    <div class="ill__meta-row"><span>теги</span><span class="ill__mono">#карьера</span></div>
  </div>
</div>
