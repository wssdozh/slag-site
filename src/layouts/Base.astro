---
import '../styles/site.css';
import latest from '../data/latest.json';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
// Only real pages get marked: nav entries pointing into the landing (`/#features`) are anchors.
const here = (target: string): 'page' | undefined =>
  path === target || path.startsWith(`${target}/`) ? 'page' : undefined;

const nav = [
  { href: '/#features', label: 'Возможности' },
  { href: '/#pricing', label: 'Тарифы' },
  { href: '/docs', label: 'Документация' },
  { href: '/releases', label: 'Релизы' },
  { href: '/support', label: 'Поддержка' },
];

const version = latest?.version ?? null;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08090a" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SLAG" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap site-header__row">
        <a class="brand" href="/">
          <img src="/icon.png" alt="" width="24" height="24" />
          <span>SLAG</span>
          {version && <span class="brand__version">{version}</span>}
        </a>

        <nav class="site-nav">
          {nav.map((item) => (
            <a href={item.href} aria-current={here(item.href)}>{item.label}</a>
          ))}
          <a href="https://github.com/wssdozh/slag-v2" rel="noreferrer">GitHub</a>
        </nav>

        <a class="btn btn--primary btn--small" href="/#download">Скачать</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__row">
        <span>SLAG · локальные заметки в markdown</span>
        <nav>
          <a href="/privacy">Политика конфиденциальности</a>
          <a href="/terms">Соглашение</a>
          <a href="/consent">Согласие на обработку данных</a>
          <a href="/support">Поддержка</a>
          <a href="https://github.com/wssdozh/slag-v2" rel="noreferrer">GitHub</a>
        </nav>
        <span class="mono">© {year}</span>
      </div>
    </footer>
  </body>
</html>
