---
import Base from '../layouts/Base.astro';
---

<Base title="Страница не найдена — SLAG" description="Такой страницы на slag.app нет.">
  <section class="wrap" style="padding-block:96px;text-align:center">
    <span class="section__label">404</span>
    <h1 style="font-size:clamp(24px,4vw,34px);margin-top:10px">Такой страницы нет</h1>
    <p class="section__lead" style="margin-inline:auto">
      Возможно, ссылка устарела. Живое есть здесь:
    </p>
    <div class="hero__actions" style="margin-top:24px">
      <a class="btn btn--primary" href="/">На главную</a>
      <a class="btn btn--ghost" href="/docs">Документация</a>
      <a class="btn btn--ghost" href="/support">Поддержка</a>
    </div>
  </section>
</Base>
