---
import '../styles/site.css';
import latest from '../data/latest.json';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
// Only real pages get marked: nav entries pointing into the landing (`/#features`) are anchors.
const here = (target: string): 'page' | undefined =>
  path === target || path.startsWith(`${target}/`) ? 'page' : undefined;

const nav = [
  { href: '/#features', label: 'Возможности' },
  { href: '/#pricing', label: 'Тарифы' },
  { href: '/docs', label: 'Документация' },
  { href: '/releases', label: 'Релизы' },
  { href: '/support', label: 'Поддержка' },
];

const footerNav = [
  {
    title: 'продукт',
    links: [
      { href: '/#features', label: 'Возможности' },
      { href: '/#pricing', label: 'Тарифы' },
      { href: '/#download', label: 'Скачать' },
      { href: '/releases', label: 'Релизы' },
    ],
  },
  {
    title: 'документация',
    links: [
      { href: '/docs', label: 'Обзор' },
      { href: '/docs/install', label: 'Установка' },
      { href: '/docs/vault', label: 'Хранилище' },
      { href: '/docs/sync', label: 'Синхронизация' },
      { href: '/docs/mcp', label: 'MCP-сервер' },
    ],
  },
  {
    title: 'сообщество',
    links: [
      { href: 'https://github.com/wssdozh/slag-v2', label: 'GitHub' },
      { href: 'https://github.com/wssdozh/slag-v2/issues', label: 'Issues' },
      { href: 'https://t.me/slag_notes', label: 'Telegram' },
      { href: '/support', label: 'Поддержка' },
    ],
  },
];

const legalLinks = [
  { href: '/privacy', label: 'Политика конфиденциальности' },
  { href: '/terms', label: 'Соглашение' },
  { href: '/consent', label: 'Согласие на обработку данных' },
];

const version = latest?.version ?? null;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#161616" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SLAG" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-header" data-header>
      <div class="wrap site-header__row">
        <a class="brand" href="/">
          <img src="/icon.png" alt="" width="24" height="24" />
          <span>SLAG</span>
          {version && <span class="brand__version">{version}</span>}
        </a>

        <nav class="site-nav">
          {nav.map((item) => (
            <a href={item.href} aria-current={here(item.href)}>{item.label}</a>
          ))}
          <a href="https://github.com/wssdozh/slag-v2" rel="noreferrer">GitHub</a>
        </nav>

        <a class="btn btn--primary btn--small" href="/#download">Скачать</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="site-footer__grid">
          <div class="site-footer__mark">
            <a class="brand" href="/">
              <img src="/icon.png" alt="" width="24" height="24" />
              <span>SLAG</span>
            </a>
            <span>Заметки и задачи в markdown на своём диске.</span>
            {version && <span class="mono">версия {version}</span>}
          </div>

          {footerNav.map((column) => (
            <nav class="site-footer__col" aria-label={column.title}>
              <span class="site-footer__title">{column.title}</span>
              {column.links.map((link) => (
                <a href={link.href} rel={link.href.startsWith('http') ? 'noreferrer' : undefined}>
                  {link.label}
                </a>
              ))}
            </nav>
          ))}
        </div>

        <div class="site-footer__bottom">
          <span>© {year} SLAG</span>
          <nav class="site-footer__legal">
            {legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          </nav>
          <a href="/health">статус сервера</a>
        </div>
      </div>
    </footer>

    <script>
      // The fade under the header belongs to the state "content is under the bar", not to the
      // header itself: without a scroll listener it would be a permanent hairline again.
      const header = document.querySelector<HTMLElement>('[data-header]');
      if (header) {
        const sync = () => {
          header.dataset.scrolled = window.scrollY > 8 ? 'true' : 'false';
        };
        sync();
        window.addEventListener('scroll', sync, { passive: true });
      }
    </script>
  </body>
</html>
